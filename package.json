{
  "dependencies": {
    "run-parallel": "^1.2.0"
  },
  "scripts": {
    "start-client": "cd animal-shelter & npm run start",
    "start-server": "node --env-file=./server/src/.env ./server/src/index.js",
    "start": "npm-run-all --parallel start-server start-client"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}